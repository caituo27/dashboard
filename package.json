{
  "name": "sprix-ai-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm dev:agent",
    "dev:agent": "pnpm --filter @sprix-ai/agent dev",
    "dev:admin": "pnpm --filter @sprix-ai/admin dev",
    "dev:all": "pnpm --parallel --filter @sprix-ai/agent --filter @sprix-ai/admin dev",
    "build": "pnpm --filter @sprix-ai/agent --filter @sprix-ai/admin build",
    "preview:agent": "pnpm --filter @sprix-ai/agent preview",
    "preview:admin": "pnpm --filter @sprix-ai/admin preview",
    "typecheck": "pnpm --filter @sprix-ai/agent --filter @sprix-ai/admin typecheck",
    "lint": "pnpm --filter @sprix-ai/agent --filter @sprix-ai/admin lint",
    "test": "pnpm test:workspace && pnpm --filter @sprix-ai/agent --filter @sprix-ai/admin test",
    "test:workspace": "node --test scripts/workspace-boundaries.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "qxun-api-generator": "^1.4.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.19.0"
  }
}
